#include <windows.h>
1 VERSIONINFO
FILEVERSION @version_numbers@,0
PRODUCTVERSION @version_numbers@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "Pianpian\0"
      VALUE "ProductVersion", "@version@\0"
      VALUE "FileVersion", "@version@\0"
      VALUE "FileDescription", "@target@\0"
      VALUE "OriginalFilename", "@target@.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
